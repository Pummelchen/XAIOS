FROM debian:13

LABEL org.opencontainers.image.title="XAIOS Linux/OpenSSH network client"
LABEL org.opencontainers.image.description="Debian 13 cross-client for XAIOS network and SSH protocol gates"

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        cpio \
        gzip \
        iproute2 \
        iputils-ping \
        netcat-openbsd \
        openssh-client \
        procps \
        python3 \
        sshpass \
        unzip \
        zip \
    && rm -rf /var/lib/apt/lists/*

COPY tests/network/debian13-client-suite.sh /usr/local/bin/xaios-network-client-suite
COPY tests/network/debian13-phase2-client-suite.sh /usr/local/bin/xaios-phase2-client-suite
COPY tests/network/debian13-client-suite-checks.sh /usr/local/bin/debian13-client-suite-checks.sh
COPY tests/network/debian13-client-suite-transport.sh /usr/local/bin/debian13-client-suite-transport.sh
COPY tests/network/parallel-client-load.py /usr/local/bin/xaios-parallel-network-client
COPY tests/network/qemu-ipv6-tcp-client.py /usr/local/bin/xaios-ipv6-tcp-client
COPY tests/network/qemu_ipv6_tcp_client_wire.py /usr/local/bin/qemu_ipv6_tcp_client_wire.py
COPY tests/network/qemu_ipv6_tcp_client_proto.py /usr/local/bin/qemu_ipv6_tcp_client_proto.py

RUN chmod 0755 \
    /usr/local/bin/xaios-network-client-suite \
    /usr/local/bin/xaios-phase2-client-suite \
    /usr/local/bin/xaios-parallel-network-client \
    /usr/local/bin/xaios-ipv6-tcp-client

CMD ["/bin/bash"]
