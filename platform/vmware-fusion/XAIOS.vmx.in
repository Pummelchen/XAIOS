.encoding = "UTF-8"
config.version = "8"
virtualHW.version = "22"
virtualHW.productCompatibility = "hosted"
displayName = "XAIOS"
guestOS = "arm-other-64"
firmware = "efi"
uefi.secureBoot.enabled = "FALSE"
numvcpus = "4"
memsize = "2048"
sata0.present = "TRUE"
sata0:0.present = "TRUE"
sata0:0.deviceType = "cdrom-image"
sata0:0.fileName = "xaios-fusion.iso"
sata0:0.startConnected = "TRUE"
sata0:1.present = "TRUE"
sata0:1.deviceType = "disk"
sata0:1.fileName = "xaios-fusion.vmdk"
sata0:1.startConnected = "TRUE"
pciBridge0.present = "TRUE"
pciBridge0.pciSlotNumber = "17"
pciBridge4.present = "TRUE"
pciBridge4.virtualDev = "pcieRootPort"
pciBridge4.pciSlotNumber = "21"
ethernet0.present = "TRUE"
ethernet0.startConnected = "TRUE"
ethernet0.connectionType = "bridged"
ethernet0.virtualDev = "e1000e"
ethernet0.addressType = "generated"
ethernet0.pciSlotNumber = "33"
sound.present = "FALSE"
usb.present = "FALSE"
serial0.present = "TRUE"
serial0.fileType = "file"
serial0.fileName = "fusion-serial.log"
# Preserve early kernel diagnostics for the automated boot gate.
serial0.tryNoRxLoss = "TRUE"
floppy0.present = "FALSE"
tools.syncTime = "FALSE"
