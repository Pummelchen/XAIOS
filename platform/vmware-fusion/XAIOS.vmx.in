.encoding = "UTF-8"
config.version = "8"
virtualHW.version = "22"
virtualHW.productCompatibility = "hosted"
displayName = "XAIOS"
guestOS = "arm-other-64"
firmware = "efi"
uefi.secureBoot.enabled = "FALSE"
# Four, and all four come online. This comment used to say one, under two
# diagnoses that were both wrong; they are worth recording as wrong rather than
# deleting, because each looked convincing. The first was that Fusion would not
# start secondaries: it starts all four, and always did. The second was that
# Fusion refused atomics and the cause therefore sat below the guest. It did
# not. The cause was ours.
#
# A secondary published `online = 1` while its MMU was still off, activating the
# kernel's tables only after the rendezvous. In that window the boot CPU saw
# `online > 1` and switched from the uniprocessor fast path to real atomics,
# while other live CPUs viewed the same memory as Device rather than Normal
# cacheable. An exclusive on a location whose attributes differ between PEs is
# not architecturally supported, and a platform may refuse it -- Fusion does,
# with DFSC 0b110101. QEMU and Apple's hypervisor permit it, which is why no
# other profile ever showed it, and why every green Fusion boot had run with one
# CPU online, where the fast path skips the atomic entirely.
#
# Locks switch to atomics at `smp_release_secondary_schedulers` now, before any
# secondary enters kernel code, so every CPU agrees on the attributes by the
# time one is taken. See F-01. `make vmware-fusion-smoke` requires
# `cpu_online=4`, so a regression here fails a gate rather than a comment.
numvcpus = "4"
# Two gibibytes: see the note in platform/qemu/run-qemu-aarch64.sh for why
# one is not currently reachable on all four profiles.
memsize = "2048"
sata0.present = "TRUE"
sata0:0.present = "TRUE"
sata0:0.deviceType = "cdrom-image"
sata0:0.fileName = "xaios-fusion.iso"
sata0:0.startConnected = "TRUE"
sata0:1.present = "TRUE"
sata0:1.deviceType = "disk"
sata0:1.fileName = "xaios-fusion.vmdk"
sata0:1.startConnected = "TRUE"
pciBridge0.present = "TRUE"
pciBridge0.pciSlotNumber = "17"
pciBridge4.present = "TRUE"
pciBridge4.virtualDev = "pcieRootPort"
pciBridge4.pciSlotNumber = "21"
pciBridge5.present = "TRUE"
pciBridge5.virtualDev = "pcieRootPort"
pciBridge5.pciSlotNumber = "22"
ethernet0.present = "TRUE"
ethernet0.startConnected = "TRUE"
ethernet0.connectionType = "bridged"
ethernet0.virtualDev = "@@XAIOS_FUSION_NIC@@"
ethernet0.addressType = "generated"
ethernet0.pciSlotNumber = "33"
sound.present = "FALSE"
usb.present = "TRUE"
usb_xhci.present = "TRUE"
usb_xhci.pciSlotNumber = "33"
serial0.present = "TRUE"
serial0.fileType = "file"
serial0.fileName = "fusion-serial.log"
# Preserve early kernel diagnostics for the automated boot gate.
serial0.tryNoRxLoss = "TRUE"
floppy0.present = "FALSE"
tools.syncTime = "FALSE"
